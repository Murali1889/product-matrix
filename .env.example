# Supabase (auth + overrides, feedback, media)
# Note: legacy ANON_KEY / SERVICE_KEY are deprecated. Use the new
# publishable / secret API keys from Supabase dashboard.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=        # sb_publishable_... (replaces anon)
SUPABASE_SECRET_KEY=              # sb_secret_... (replaces service_role)

# OpenAI (recommendations, sales intel, chat)
OPENAI_API_KEY=

# Metabase (primary data source — server-only, never NEXT_PUBLIC_)
METABASE_URL=https://hyperverge.metabaseapp.com
METABASE_API_KEY=
METABASE_DB_ID=201

# Optional: Google Custom Search (company research)
GOOGLE_SEARCH_API_KEY=
SERPAPI_KEY=

# Slack bot token (users:read) for resolving exception raised-by ids to names
SLACK_BOT_TOKEN=
# Exceptions sheet Apps Script web-app URL
EXCEPTIONS_GS_URL=
